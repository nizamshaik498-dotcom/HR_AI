  {"id":"tech-001","round":"technical","type":"mcq","question":"Which data structure follows the LIFO principle?","options":["Queue","Stack","Heap","Graph"],"answer":1,"explanation":"A stack is Last-In-First-Out; a queue is First-In-First-Out."},
  {"id":"tech-002","round":"technical","type":"mcq","question":"What is the time complexity of binary search on a sorted array?","options":["O(n)","O(log n)","O(n log n)","O(1)"],"answer":1,"explanation":"Binary search halves the search space each step, giving O(log n)."},
  {"id":"tech-003","round":"technical","type":"mcq","question":"Which SQL keyword removes duplicate rows from a result set?","options":["UNIQUE","DISTINCT","DIFFERENT","REMOVE"],"answer":1,"explanation":"SELECT DISTINCT returns only unique rows."},
  {"id":"tech-004","round":"technical","type":"mcq","question":"Which HTTP status code means 'Not Found'?","options":["200","301","404","500"],"answer":2,"explanation":"404 = resource not found; 200 OK; 301 redirect; 500 server error."},
  {"id":"tech-005","round":"technical","type":"open","question":"Explain the difference between a process and a thread.","keywords":["process","thread","memory","shared","context"],"ideal_points":["Process = independent program with its own memory","Thread = lightweight unit inside a process","Threads share memory; processes are isolated","Thread context switching is cheaper"]},
  {"id":"tech-006","round":"technical","type":"mcq","question":"What does ACID stand for in databases?","options":["Atomicity, Consistency, Isolation, Durability","Availability, Consistency, Isolation, Durability","Atomicity, Concurrency, Isolation, Durability","Atomicity, Consistency, Integrity, Durability"],"answer":0,"explanation":"ACID = Atomicity, Consistency, Isolation, Durability."},
  {"id":"tech-007","round":"technical","type":"mcq","question":"Which sorting algorithm has the best average-case time complexity?","options":["Bubble Sort","Quick Sort","Merge Sort","Insertion Sort"],"answer":2,"explanation":"Merge Sort guarantees O(n log n) average and worst case."},
  {"id":"tech-008","round":"technical","type":"mcq","question":"What is a primary key in a database?","options":["A unique identifier for each row","A foreign key reference","An index for fast lookup","A column with default values"],"answer":0,"explanation":"A primary key uniquely identifies each row in a table."},
  {"id":"tech-009","round":"technical","type":"open","question":"Explain how a hash table works and what a collision is.","keywords":["hash","bucket","collision","chaining","open addressing"],"ideal_points":["Hash function maps keys to buckets","Collision = two keys map to same bucket","Resolution: chaining or open addressing","Average O(1) lookup"]},
  {"id":"tech-010","round":"technical","type":"mcq","question":"Which design pattern ensures a class has only one instance?","options":["Factory","Singleton","Observer","Strategy"],"answer":1,"explanation":"Singleton pattern restricts instantiation to one object."},
  {"id":"tech-011","round":"technical","type":"open","question":"What is the difference between TCP and UDP?","keywords":["connection","reliable","order","speed","use case"],"ideal_points":["TCP = connection-oriented, reliable, ordered","UDP = connectionless, faster, no guarantees","Use TCP for web, email; UDP for streaming, gaming","Trade-off: reliability vs speed"]},
  {"id":"tech-012","round":"technical","type":"mcq","question":"What is the time complexity of inserting into a balanced BST?","options":["O(1)","O(log n)","O(n)","O(n log n)"],"answer":1,"explanation":"Balanced BST (AVL, Red-Black) maintains height log n."},
  {"id":"tech-013","round":"technical","type":"open","question":"Explain REST vs GraphQL.","keywords":["endpoint","query","overfetch","underfetch","schema"],"ideal_points":["REST = multiple endpoints, fixed responses","GraphQL = single endpoint, flexible queries","GraphQL prevents over/under-fetching","REST simpler for simple APIs"]},
